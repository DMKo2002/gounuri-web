# URL del Panel Admin desplegado (sin barra final)
NEXT_PUBLIC_PANEL_URL=https://panel.gounuri.com

# Mismo proyecto Supabase que el Panel Admin (mismas credenciales de login)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cuenta MP de Gounuri — para la baja (/api/baja) y ahora también para el
# alta de suscripciones (/api/billing/subscribe, /perfil/plan) — el pago de
# planes se hace acá en gounuri.com desde el 2026-08-12, no en Panel Admin.
GOUNURI_MP_ACCESS_TOKEN=

# Debe coincidir con el mismo flag en Panel Admin — si está en 'false' u
# omitido, /perfil/plan no deja iniciar un pago.
BILLING_ENABLED=true

# Para dar de alta {slug}.gounuri.com en Vercel al crear un tenant (ver
# lib/vercel.ts). Mismo token/team que usa Panel Admin — Vercel > tu cuenta >
# Settings > Tokens. VERCEL_TEAM_ID = team_iXqWFN1rtfa5rHbCYtOIDHH9
VERCEL_TOKEN=
VERCEL_TEAM_ID=team_iXqWFN1rtfa5rHbCYtOIDHH9
